+# real process death (os._exit) between begin_send and the provider result
+import os, sys, json
+sys.path.insert(0, sys.argv[1])
+from sanad import Ledger, ClaimStore, Gateway, PreAuthorization
+from sanad.providers import Provider
+root = sys.argv[2]
+class Dies(Provider):
+    def execute(self, a, c, e):
+        os._exit(7)
+ledger = Ledger(os.path.join(root, "ledger.jsonl"))
+claims = ClaimStore(os.path.join(root, "claims.db"))
+pre = PreAuthorization(ledger, os.path.join(root, "pre_auth.json"))
+gw = Gateway(ledger, claims, pre, Dies())
+gw.execute(gw.derive_approval("coffee", 5000, "USD"))
diff --git a/tests/test_exp016_reservation.py b/tests/test_exp016_reservation.py
new file mode 100644
index 0000000..e869948
--- /dev/null
+++ b/tests/test_exp016_reservation.py
@@ -0,0 +1,457 @@
+# -*- coding: utf-8 -*-
+"""EXP-016 — atomic budget reservation (acceptance tests, written FIRST).
+
+Frozen expectations for the fix to GAP-BUDGET-1: a GRANTED approval that has
+not executed yet must still count against the daily budget, atomically,
+across threads AND processes, and survive crashes.
+
+Invariant under test:  money_out + reserved_or_in_flight  <=  daily budget.
+Measurement rule: money out is read from an INDEPENDENT provider witness.
+
+Test kinds (recorded in the evidence, not hidden):
+  behavioural — assert observable behaviour; meaningful on the baseline
+  api         — touches the new ClaimStore/reconcile API; on the baseline
+                these ERROR with AttributeError/ImportError, which proves
+                nothing about behaviour, only that the API does not exist yet
+"""
+import json
+import multiprocessing as mp
+import os
+import random
+import threading
+
+from sanad import Ledger, ClaimStore, Gateway, PreAuthorization
+from sanad.gateway_timed import TimedGateway
+from sanad.identity import Signer
+from sanad.providers import Provider, ProviderRejected
+from sanad.reconcile import recover_on_startup
+from sanad.validity import TrustedKeys, TimedSignedPreAuthorization, timed_sign
+
+BUDGET, LIMIT = 10_000, 5_000
+
+
+class Crash(BaseException):
+    """Process death, not an error: the Gateway must not swallow it."""
+
+
+class Witness(Provider):
+    """Independent record of money that left (thread-safe, in-memory)."""
+    name = "memory"
+
+    def __init__(self):
+        self.calls, self.total_minor, self.records = 0, 0, {}
+        self.mode = "ok"            # ok | lost_after | reject | crash
+        self._lock = threading.Lock()
+
+    def execute(self, amount_minor, currency, execution_id):
+        with self._lock:
+            self.calls += 1
+            if self.mode == "crash":
+                raise Crash()
+            if self.mode == "reject":
+                raise ProviderRejected("card declined")
+            self.total_minor += amount_minor
+            self.records[execution_id] = {"receipt": "rc_" + execution_id,
+                                          "amount_minor": amount_minor}
+        if self.mode == "lost_after":
+            raise TimeoutError("charged, response lost")
+        return self.records[execution_id]
+
+    def find_by_execution_id(self, execution_id):
+        return self.records.get(execution_id)
+
+    def retrieve(self, receipt):
+        for r in self.records.values():
+            if r["receipt"] == receipt:
+                return r
+        raise LookupError(receipt)
+
+
+def _doc(tmp_path, budget=BUDGET, extra=None):
+    terms = {"auto_limit_minor": LIMIT, "daily_budget_minor": budget,
+             "currency": "USD", "blocked_categories": []}
+    terms.update(extra or {})
+    p = tmp_path / "pre_auth.json"
+    p.write_text(json.dumps(terms), encoding="utf-8")
+    return p
+
+
+def plain(tmp_path, budget=BUDGET, ledger_cls=Ledger):
+    ledger = ledger_cls(str(tmp_path / "ledger.jsonl"))
+    claims = ClaimStore(str(tmp_path / "claims.db"))
+    pre = PreAuthorization(ledger, str(_doc(tmp_path, budget)))
+    pre.sign("tester")
+    prov = Witness()
+    return ledger, claims, Gateway(ledger, claims, pre, prov), prov
+
+
+class Clock:
+    def __init__(self, t=1_000_000.0):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+
+def timed(tmp_path, budget=BUDGET, extra=None, ledger_cls=Ledger):
+    clock = Clock()
+    ledger = ledger_cls(str(tmp_path / "ledger.jsonl"))
+    claims = ClaimStore(str(tmp_path / "claims.db"))
+    doc = _doc(tmp_path, budget, {"valid_days": 7, "approval_ttl_seconds": 300,
+                                  **(extra or {})})
+    m = Signer("mohamed")
+    keys = TrustedKeys(ledger, {"mohamed": m.public_key_b64}, clock=clock)
+    pre = TimedSignedPreAuthorization(ledger, str(doc), keys, clock=clock)
+    timed_sign(pre, m)
+    prov = Witness()
+    return clock, ledger, claims, TimedGateway(ledger, claims, pre, prov,
+                                               clock=clock), prov
+
+
+def states(ledger, stage):
+    return [r["state"] for r in ledger.rows() if r["stage"] == stage]
+
+
+# ------------------------------------------------------------ behavioural
+def test_R1_control_sequential_flow_enforces_budget(tmp_path):
+    ledger, claims, gw, prov = plain(tmp_path)
+    granted = 0
+    for _ in range(6):
+        ap = gw.derive_approval("coffee", 5000, "USD")
+        if ap:
+            granted += 1
+            gw.execute(ap)
+    assert granted == 2 and prov.total_minor == BUDGET
+
+
+def test_R2_derive_all_then_execute_all_cannot_exceed_budget(tmp_path):
+    ledger, claims, gw, prov = plain(tmp_path)
+    aps = [gw.derive_approval("coffee", 5000, "USD") for _ in range(6)]
+    granted = [a for a in aps if a]
+    assert len(granted) == 2
+    assert states(ledger, "approval").count("DENIED_DAILY_BUDGET") == 4
+    for a in granted:
+        assert gw.execute(a)["state"] == "EXECUTED"
+    assert prov.total_minor <= BUDGET and prov.calls == 2
+
+
+def test_R3_threads_forced_interleaving_cannot_exceed_budget(tmp_path):
+    ledger, claims, gw, prov = plain(tmp_path)
+    n = 8
+    barrier, out = threading.Barrier(n), [None] * n
+
+    def worker(i):
+        ap = gw.derive_approval("coffee", 5000, "USD")
+        barrier.wait(timeout=10)
+        out[i] = gw.execute(ap) if ap else None
+
+    ts = [threading.Thread(target=worker, args=(i,)) for i in range(n)]
+    [t.start() for t in ts]
+    [t.join(timeout=30) for t in ts]
+    assert sum(1 for o in out if o and o["state"] == "EXECUTED") == 2
+    assert prov.total_minor <= BUDGET and prov.calls == 2
+
+
+class FileWitness(Provider):
+    """Cross-process witness: O_APPEND line per call."""
+    name = "file"
+
+    def __init__(self, path):
+        self.path = path
+
+    def execute(self, amount_minor, currency, execution_id):
+        fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_CREAT)
+        os.write(fd, f"{amount_minor}\n".encode())
+        os.close(fd)
+        return {"receipt": "rc_" + execution_id, "amount_minor": amount_minor}
+
+    def find_by_execution_id(self, execution_id):
+        return None
+
+    def retrieve(self, receipt):
+        raise NotImplementedError
+
+
+def _proc_worker(root, barrier, q):
+    from pathlib import Path
+    ledger = Ledger(os.path.join(root, "ledger.jsonl"))
+    claims = ClaimStore(os.path.join(root, "claims.db"))
+    pre = PreAuthorization(ledger, os.path.join(root, "pre_auth.json"))
+    gw = Gateway(ledger, claims, pre, FileWitness(os.path.join(root, "w.log")))
+    ap = gw.derive_approval("coffee", 5000, "USD")
+    barrier.wait(timeout=30)
+    q.put(gw.execute(ap)["state"] if ap else "NO_APPROVAL")
+
+
+def test_R4_separate_processes_cannot_exceed_budget(tmp_path):
+    ledger, claims, gw, prov = plain(tmp_path)        # signs pre-auth, makes db
+    ctx = mp.get_context("fork")
+    n = 6
+    barrier, q = ctx.Barrier(n), ctx.Queue()
+    ps = [ctx.Process(target=_proc_worker, args=(str(tmp_path), barrier, q))
+          for _ in range(n)]
+    [p.start() for p in ps]
+    res = [q.get(timeout=60) for _ in range(n)]
+    [p.join(timeout=30) for p in ps]
+    wlog = tmp_path / "w.log"
+    total = sum(int(x) for x in wlog.read_text().split()) if wlog.exists() else 0
+    assert res.count("EXECUTED") == 2, res
+    assert total <= BUDGET
+
+
+def test_R5_unknown_keeps_its_reservation_until_settled(tmp_path):
+    ledger, claims, gw, prov = plain(tmp_path, budget=8000)
+    assert gw.execute(gw.derive_approval("a", 5000, "USD"))["state"] == "EXECUTED"
+    prov.mode = "lost_after"
+    assert gw.execute(gw.derive_approval("b", 3000, "USD"))["state"] == "UNKNOWN"
+    prov.mode = "ok"
+    # money in flight is invisible to the ledger sum but NOT to the budget
+    assert gw.derive_approval("c", 1000, "USD") is None
+    assert states(ledger, "approval")[-1] == "DENIED_DAILY_BUDGET"
+    recover_on_startup(ledger, claims, prov)                  # EXECUTED, 8000
+    assert gw.derive_approval("c", 1000, "USD") is None       # still no room
+    assert prov.total_minor == 8000
+
+
+def test_R6_rejected_releases_the_budget(tmp_path):
+    ledger, claims, gw, prov = plain(tmp_path)
+    prov.mode = "reject"
+    assert gw.execute(gw.derive_approval("a", 5000, "USD"))["state"] == "REJECTED"
+    prov.mode = "ok"
+    assert gw.execute(gw.derive_approval("b", 5000, "USD"))["state"] == "EXECUTED"
+    assert gw.execute(gw.derive_approval("c", 5000, "USD"))["state"] == "EXECUTED"
+    assert gw.derive_approval("d", 5000, "USD") is None
+    assert prov.total_minor == BUDGET
+
+
+def test_R7_not_executed_settlement_releases_the_budget(tmp_path):
+    ledger, claims, gw, prov = plain(tmp_path)
+    prov.mode = "crash"
+    try:
+        gw.execute(gw.derive_approval("a", 5000, "USD"))
+    except Crash:
+        pass
+    prov.mode = "ok"
+    assert gw.derive_approval("b", 5000, "USD") is not None   # 5000 in flight
+    assert gw.derive_approval("c", 5000, "USD") is None       # full: 5000+5000
+    recover_on_startup(ledger, claims, prov)                  # NOT_EXECUTED
+    assert ledger.last(stage="resolve")["state"] == "NOT_EXECUTED"
+    assert gw.derive_approval("c", 5000, "USD") is not None   # room is back
+    assert prov.calls == 1                                    # only the crash
+
+
+def test_R8_expired_unexecuted_approval_releases_its_reservation(tmp_path):
+    clock, ledger, claims, gw, prov = timed(tmp_path)
+    a1 = gw.derive_approval("a", 5000, "USD")
+    a2 = gw.derive_approval("b", 5000, "USD")
+    assert a1 and a2
+    assert gw.derive_approval("c", 5000, "USD") is None       # reserved: full
+    clock.t += 301                                            # both expire
+    a3 = gw.derive_approval("c", 5000, "USD")
+    assert a3 is not None
+    assert "RELEASED" in states(ledger, "reserve")
+    rel = [r for r in ledger.rows()
+           if r["stage"] == "reserve" and r["state"] == "RELEASED"]
+    assert {r["reason"] for r in rel} == {"EXPIRED"}
+    assert gw.execute(a3)["state"] == "EXECUTED"
+    # an expired-and-released approval can no longer spend the budget it gave up
+    a1["ttl_seconds"] = None                                  # EXP-017 trick
+    assert gw.execute(a1)["state"].startswith("DENIED")
+    assert prov.calls == 1 and prov.total_minor == 5000
+
+
+def test_R9_expiry_never_releases_a_sent_or_unknown_reservation(tmp_path):
+    clock, ledger, claims, gw, prov = timed(tmp_path, budget=5000)
+    prov.mode = "lost_after"
+    assert gw.execute(gw.derive_approval("a", 5000, "USD"))["state"] == "UNKNOWN"
+    prov.mode = "ok"
+    clock.t += 10_000                                         # way past ttl
+    recover_on_startup(ledger, claims, _Dark(), now=clock())  # cannot settle
+    assert gw.derive_approval("b", 100, "USD") is None        # still held
+    assert not [r for r in ledger.rows()
+                if r["stage"] == "reserve" and r["state"] == "RELEASED"]
+
+
+class _Dark(Provider):
+    """Provider that cannot be reached: settlement stays UNRESOLVED."""
+    def find_by_execution_id(self, execution_id):
+        raise ConnectionError("down")
+
+    def retrieve(self, receipt):
+        raise ConnectionError("down")
+
+
+def test_R10_orphan_reservation_is_released_after_grace(tmp_path):
+    """Crash between the SQLite reserve and the ledger GRANTED row."""
+    class CrashOnGranted(Ledger):
+        def append(self, stage, state, detail="", **f):
+            if stage == "approval" and state == "GRANTED":
+                raise Crash()
+            return super().append(stage, state, detail, **f)
+
+    ledger, claims, gw, prov = plain(tmp_path, ledger_cls=CrashOnGranted)
+    try:
+        gw.derive_approval("a", 5000, "USD")
+        raise AssertionError("expected crash")
+    except Crash:
+        pass
+    ok = Ledger(str(tmp_path / "ledger.jsonl"))               # restart
+    gw2 = Gateway(ok, ClaimStore(str(tmp_path / "claims.db")), gw.pre_auth, prov)
+    gw2.derive_approval("b", 5000, "USD")                     # orphan holds 5000
+    assert gw2.derive_approval("c", 5000, "USD") is None
+    import time
+    # inside the grace window a live derive might still be writing: no release
+    recover_on_startup(ok, gw2.claims, prov, now=time.time(),
+                       orphan_grace_seconds=3600)
+    assert gw2.derive_approval("c", 5000, "USD") is None
+    recover_on_startup(ok, gw2.claims, prov, now=time.time() + 7200,
+                       orphan_grace_seconds=3600)
+    rel = [r for r in ok.rows() if r["stage"] == "reserve"
+           and r["state"] == "RELEASED"]
+    assert [r["reason"] for r in rel] == ["ORPHAN"]
+    assert gw2.derive_approval("c", 5000, "USD") is not None
+    assert prov.calls == 0
+
+
+def test_R11_orphan_rule_fails_closed_when_send_evidence_exists(tmp_path):
+    """RESERVED/SENT without a GRANTED row but WITH send evidence is an
+    anomaly, never a release."""
+    import time
+    ledger, claims, gw, prov = plain(tmp_path)
+    ok, _ = claims.reserve("AP-ghost", 5000, ledger._now()[:10], BUDGET,
+                           now=time.time())
+    assert ok
+    ledger.append("claim", "CLAIMED", "AP-ghost -> EX-x",
+                  approval_id="AP-ghost", execution_id="EX-x")
+    recover_on_startup(ledger, claims, prov, now=time.time() + 7200,
+                       orphan_grace_seconds=0)
+    assert states(ledger, "reserve").count("ANOMALY") == 1
+    assert "RELEASED" not in states(ledger, "reserve")
+    assert gw.derive_approval("a", 5000, "USD") is not None   # 5000 still held
+    assert gw.derive_approval("b", 5000, "USD") is None
+
+
+def test_R12_execute_without_reservation_is_denied_no_provider_call(tmp_path):
+    ledger, claims, gw, prov = plain(tmp_path)
+    # a GRANTED row that never went through the reservation path
+    ledger.append("approval", "GRANTED", "AP-forged", approval_id="AP-forged",
+                  approver="x (pre-auth)", amount_minor=5000, currency="USD",
+                  item="coffee")
+    row = gw.execute({"approval_id": "AP-forged", "amount_minor": 5000,
+                      "currency": "USD", "item": "coffee"})
+    assert row["state"] == "DENIED_NO_RESERVATION"
+    assert prov.calls == 0
+
+
+def test_R13_human_approval_counts_as_spend_but_is_not_gated(tmp_path):
+    ledger, claims, gw, prov = plain(tmp_path)
+    h = gw.grant_human_approval("big", 12_000, "USD", "manager")  # > budget
+    assert gw.execute(h)["state"] == "EXECUTED"               # unchanged
+    assert gw.derive_approval("coffee", 100, "USD") is None   # but it is spend
+    assert states(ledger, "approval")[-1] == "DENIED_DAILY_BUDGET"
+    assert prov.total_minor == 12_000
+
+
+def test_R14_double_execute_still_one_provider_call(tmp_path):
+    ledger, claims, gw, prov = plain(tmp_path)
+    ap = gw.derive_approval("a", 5000, "USD")
+    assert gw.execute(ap)["state"] == "EXECUTED"
+    assert gw.execute(ap)["state"] == "DENIED_APPROVAL_CONSUMED"
+    assert prov.calls == 1
+
+
+def test_R15_seeded_random_schedule_never_exceeds_budget(tmp_path):
+    rnd = random.Random(1609)
+    clock, ledger, claims, gw, prov = timed(tmp_path, budget=20_000)
+    pending = []
+    for step in range(300):
+        op = rnd.choice(["derive", "derive", "exec", "exec", "fail", "tick",
+                         "recover"])
+        if op == "derive":
+            ap = gw.derive_approval("x", rnd.choice([500, 1000, 2500, 5000]),
+                                    "USD")
+            if ap:
+                pending.append(ap)
+        elif op in ("exec", "fail") and pending:
+            ap = pending.pop(rnd.randrange(len(pending)))
+            prov.mode = "reject" if op == "fail" else rnd.choice(
+                ["ok", "ok", "lost_after"])
+            gw.execute(ap)
+            prov.mode = "ok"
+        elif op == "tick":
+            clock.t += rnd.choice([10, 100, 400])
+        elif op == "recover":
+            recover_on_startup(ledger, claims, prov, now=clock())
+        assert prov.total_minor <= 20_000, (step, op, prov.total_minor)
+
+
+# ------------------------------------------------------------------- api
+def test_R16_api_committed_minor_tracks_state_machine(tmp_path):
+    ledger, claims, gw, prov = plain(tmp_path)
+    day = ledger._now()[:10]
+    ap = gw.derive_approval("a", 3000, "USD")
+    assert claims.committed_minor(day) == 3000                # RESERVED
+    gw.execute(ap)
+    assert claims.committed_minor(day) == 3000                # CONSUMED
+    claims.set_status(ledger.last(stage="execute", state="EXECUTED")
+                      ["execution_id"], "REJECTED")           # must NOT release
+    assert claims.committed_minor(day) == 3000                # consumed is final
+
+
+def test_R17_api_release_is_idempotent_and_single(tmp_path):
+    ledger, claims, gw, prov = plain(tmp_path)
+    day = ledger._now()[:10]
+    prov.mode = "reject"
+    row = gw.execute(gw.derive_approval("a", 3000, "USD"))
+    assert row["state"] == "REJECTED" and claims.committed_minor(day) == 0
+    claims.set_status(row["execution_id"], "REJECTED")        # again
+    claims.set_status(row["execution_id"], "NOT_EXECUTED")    # and again
+    assert claims.committed_minor(day) == 0                   # not negative
+
+
+def test_R18_api_verify_reservations_reports_disagreement(tmp_path):
+    from sanad.reconcile import verify_reservations
+    ledger, claims, gw, prov = plain(tmp_path)
+    ap = gw.derive_approval("a", 3000, "USD")
+    gw.execute(ap)
+    assert verify_reservations(ledger, claims) == []
+    # simulate a lost database row
+    import sqlite3
+    c = sqlite3.connect(str(tmp_path / "claims.db"))
+    c.execute("DELETE FROM reservations")
+    c.commit()
+    c.close()
+    kinds = {a["kind"] for a in verify_reservations(ledger, claims)}
+    assert "NO_RESERVATION_ROW" in kinds
+
+
+def test_R19_api_consumed_without_ledger_evidence_is_flagged(tmp_path):
+    from sanad.reconcile import verify_reservations
+    import time
+    ledger, claims, gw, prov = plain(tmp_path)
+    claims.reserve("AP-x", 100, ledger._now()[:10], BUDGET, now=time.time())
+    ledger.append("approval", "GRANTED", "AP-x", approval_id="AP-x",
+                  amount_minor=100, currency="USD", item="i")
+    claims.begin_send("AP-x", "EX-x")
+    claims.set_status("EX-x", "EXECUTED")                     # CONSUMED, no ledger
+    kinds = {a["kind"] for a in verify_reservations(ledger, claims)}
+    assert "CONSUMED_NOT_IN_LEDGER" in kinds
+
+
+def test_R20_real_process_death_mid_flight_is_held_then_settled(tmp_path):
+    """os._exit between the claim and the provider result."""
+    import subprocess, sys
+    ledger, claims, gw, prov = plain(tmp_path)               # signs + makes db
+    here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    script = os.path.join(os.path.dirname(os.path.abspath(__file__)),
+                          "_exp016_os_exit_crash.py")
+    r = subprocess.run([sys.executable, script, here, str(tmp_path)],
+                       timeout=60)
+    assert r.returncode == 7
+    # the dead process left a claim and a held reservation, no result
+    assert claims.unresolved() != []
+    assert gw.derive_approval("a", 5000, "USD") is not None   # 5000 held + 5000
+    assert gw.derive_approval("b", 5000, "USD") is None       # full
+    recover_on_startup(ledger, claims, prov)                  # no trace
+    assert ledger.last(stage="resolve")["state"] == "NOT_EXECUTED"
+    assert gw.derive_approval("b", 5000, "USD") is not None   # released
