+                    and r.get("state") == "GRANTED" and r.get("approval_id")}
+    _, _, executed, _, _ = _ledger_index(ledger)
+    table = {r["approval_id"]: r for r in claims.reservation_rows()}
+    found = []
+    for aid, g in granted_rows.items():
+        if g.get("reservation_day") and aid not in table:
+            found.append({"kind": "NO_RESERVATION_ROW", "approval_id": aid})
+    for aid, row in table.items():
+        if row["status"] in ("RESERVED", "SENT", "CONSUMED") \
+                and aid not in granted_rows:
+            found.append({"kind": "NO_GRANTED_ROW", "approval_id": aid})
+        if row["status"] == "CONSUMED" and row["execution_id"] not in executed:
+            found.append({"kind": "CONSUMED_NOT_IN_LEDGER",
+                          "approval_id": aid})
+    return found
