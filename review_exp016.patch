+def _ensure_reservations(c):
+    c.execute("""CREATE TABLE IF NOT EXISTS reservations(
+        approval_id    TEXT PRIMARY KEY,
+        day            TEXT NOT NULL,
+        amount_minor   INTEGER NOT NULL,
+        status         TEXT NOT NULL,
+        gated          INTEGER NOT NULL DEFAULT 1,
+        created_at     REAL NOT NULL,
+        expires_at     REAL,
+        execution_id   TEXT,
+        release_reason TEXT,
+        released_at    REAL)""")
+    c.execute("CREATE INDEX IF NOT EXISTS idx_res_day ON reservations(day)")
+    c.execute("CREATE INDEX IF NOT EXISTS idx_res_exec "
+              "ON reservations(execution_id)")
+
