+# ======================================================================
+# EXP-016 — reservation recovery and verification
+# ======================================================================
+import time as _time
+
+_SEND_STAGES = ("claim", "pre-action", "execute", "resolve")
+
+
+def _ledger_index(ledger):
+    granted, send_evidence, executed, released, anomalies = (
+        set(), set(), set(), set(), set())
+    for r in ledger.rows():
+        aid, eid = r.get("approval_id"), r.get("execution_id")
+        st, state = r.get("stage"), r.get("state")
+        if st == "approval" and state == "GRANTED" and aid:
+            granted.add(aid)
+        if st in _SEND_STAGES:
+            if aid:
+                send_evidence.add(aid)
+            if eid:
+                send_evidence.add(eid)
+        if st in ("execute", "resolve") and state == "EXECUTED" and eid:
+            executed.add(eid)
+        if st == "reserve" and state == "RELEASED" and aid:
+            released.add(aid)
+        if st == "reserve" and state == "ANOMALY" and aid:
+            anomalies.add((aid, r.get("kind")))
+    return granted, send_evidence, executed, released, anomalies
+
+
+def recover_reservations(ledger: Ledger, claims: ClaimStore, now=None,
+                         orphan_grace_seconds=60):
+    """Return reservations to a consistent state. Rules, strictest first:
+
+    - SENT and CONSUMED are NEVER released here, whatever the ledger says.
+      Only settlement (set_status) moves them: UNKNOWN stays held.
+    - RESERVED + no GRANTED row + older than the grace window + NO send
+      evidence anywhere (claims table or ledger) -> ORPHAN, released.
+      The grace window exists because a live derive_approval may be between
+      its reserve and its GRANTED write.
+    - RESERVED + no GRANTED row + send evidence -> ANOMALY, NOT released
+      (fail closed: the budget stays held, a human looks).
+    - RESERVED past its signed expiry -> EXPIRED, released.
+    Every release is logged to the ledger once (idempotent)."""
+    now = _time.time() if now is None else now
+    granted, send_ev, _, logged_rel, logged_anom = _ledger_index(ledger)
+    out = {"released": [], "anomalies": []}
+
+    def anomaly(row, kind, detail):
+        if (row["approval_id"], kind) not in logged_anom:
+            ledger.append("reserve", "ANOMALY", detail,
+                          approval_id=row["approval_id"], kind=kind)
+        out["anomalies"].append((row["approval_id"], kind))
+
+    for aid in claims.release_expired(now=now):
+        if aid not in logged_rel:
+            ledger.append("reserve", "RELEASED",
+                          f"{aid} expired unexecuted — budget returned",
+                          approval_id=aid, reason="EXPIRED")
+            logged_rel.add(aid)
+        out["released"].append((aid, "EXPIRED"))
+
+    for row in claims.reservation_rows():
+        aid, status = row["approval_id"], row["status"]
+        if status == "RESERVED" and aid not in granted:
+            has_send = (aid in send_ev) or (row["execution_id"] is not None)
+            if has_send:
+                anomaly(row, "RESERVED_WITH_SEND_EVIDENCE_NO_GRANTED",
+                        f"{aid} RESERVED, no GRANTED row, but send evidence "
+                        "exists — held, not released")
+            elif now - row["created_at"] >= orphan_grace_seconds:
